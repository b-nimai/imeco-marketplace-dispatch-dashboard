# Copy to .env and fill in. .env is gitignored — never commit it.
#
# NOTE: VITE_* variables are inlined into the client bundle at build time and are
# publicly readable in the deployed JS. The API key below is protected by its
# HTTP-referrer + Sheets-API-only restrictions in Google Cloud, not by secrecy.

# API key from the dedicated GCP project for this dashboard.
# Restricted to: Google Sheets API only + referrers (localhost + Vercel domain).
VITE_GOOGLE_API_KEY=

# Spreadsheet holding the daily marketplace dispatch data.
# Must be shared "Anyone with the link -> Viewer" or the API key gets a 403.
VITE_DISPATCH_SPREADSHEET_ID=
